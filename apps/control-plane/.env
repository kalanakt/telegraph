# ──────────────────────────────────────────────────
# Telegraph Control Plane — Development Environment
# ──────────────────────────────────────────────────
# Copy to .env and adjust values as needed.

# ─── Server ───────────────────────────────────────
PORT=3001

# ─── Database (PostgreSQL) ────────────────────────
# Local Postgres started by `pnpm infra:up`.
DATABASE_URL=postgresql://telegraph:telegraph@localhost:5432/telegraph_dev

# ─── Redis ────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth ─────────────────────────────────────────
# Secret used to sign JWTs. Any string works for local dev.
JWT_SECRET=dev-jwt-secret-change-me

# ─── Encryption ───────────────────────────────────
# 32-byte key (base64-encoded) for AES-256-GCM bot-token encryption.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BOT_TOKEN_MASTER_KEY=7c2ca6f220513e336b73978ee1985f308797aeed117471e5ad13e079a6076a84

# ─── CORS ─────────────────────────────────────────
# Comma-separated origins allowed by CORS. Defaults to the Vite dev server.
CORS_ORIGIN=http://localhost:5173

# ─── Logging ──────────────────────────────────────
# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# ─── Telemetry (optional) ─────────────────────────
# OTEL Collector gRPC endpoint. Remove or leave empty to disable tracing.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
