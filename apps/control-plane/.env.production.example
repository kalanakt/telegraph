# ──────────────────────────────────────────────────
# Telegraph Control Plane — Production Environment
# ──────────────────────────────────────────────────
# Copy to .env.production (or inject via your hosting provider's
# secrets/environment config). Never commit real values.

# ─── Server ───────────────────────────────────────
PORT=3001

# ─── Database (PostgreSQL) ────────────────────────
# Use a connection-pooler URL (e.g. PgBouncer) and SSL in production.
DATABASE_URL=postgresql://user:password@db-host:5432/telegraph?sslmode=require

# ─── Redis ────────────────────────────────────────
# Use TLS-enabled Redis (rediss://) in production.
REDIS_URL=rediss://default:password@redis-host:6379

# ─── Auth ─────────────────────────────────────────
# Strong random secret, ≥64 characters recommended.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# ─── Encryption ───────────────────────────────────
# 32-byte key (base64-encoded) for AES-256-GCM bot-token encryption.
# MUST be identical across control-plane and runtime.
# Generate ONCE with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Back this key up securely — losing it makes all stored bot tokens unrecoverable.
BOT_TOKEN_MASTER_KEY=

# ─── CORS ─────────────────────────────────────────
# Comma-separated production origins (your web app domain).
CORS_ORIGIN=https://app.yourdomain.com

# ─── Logging ──────────────────────────────────────
LOG_LEVEL=info

# ─── Telemetry (optional) ─────────────────────────
# OTEL Collector gRPC endpoint. Remove to disable tracing.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
