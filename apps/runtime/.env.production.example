# ──────────────────────────────────────────────────
# Telegraph Runtime — Production Environment
# ──────────────────────────────────────────────────
# Copy to .env.production (or inject via your hosting provider's
# secrets/environment config). Never commit real values.

# ─── Server ───────────────────────────────────────
PORT=3002

# ─── Run Mode ─────────────────────────────────────
# In production you can split the server and workers into separate processes
# for independent scaling:
#   "all"    — run webhook server + all workers in one process
#   "server" — webhook server only (handles Telegram webhooks)
#   "worker" — workers only (processes BullMQ jobs)
RUN_MODE=all

# ─── Database (PostgreSQL) ────────────────────────
DATABASE_URL=postgresql://user:password@db-host:5432/telegraph?sslmode=require

# ─── Redis ────────────────────────────────────────
REDIS_URL=rediss://default:password@redis-host:6379

# ─── Encryption ───────────────────────────────────
# MUST be identical to the control-plane's key.
BOT_TOKEN_MASTER_KEY=

# ─── AI (OpenAI-compatible) ───────────────────────
# Required for ai_prompt nodes. Leave empty if AI features are unused.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com

# ─── Logging ──────────────────────────────────────
LOG_LEVEL=info

# ─── Telemetry (optional) ─────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
