# ──────────────────────────────────────────────────
# Telegraph Runtime — Development Environment
# ──────────────────────────────────────────────────
# Copy to .env and adjust values as needed.

# ─── Server ───────────────────────────────────────
PORT=3002

# ─── Run Mode ─────────────────────────────────────
# "all"    — run webhook server + all workers (recommended for local dev)
# "server" — webhook server only
# "worker" — workers only
RUN_MODE=all

# ─── Database (PostgreSQL) ────────────────────────
DATABASE_URL=postgresql://telegraph:telegraph@localhost:5432/telegraph_dev

# ─── Redis ────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Encryption ───────────────────────────────────
# Must match the same key used in the control-plane.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BOT_TOKEN_MASTER_KEY=7c2ca6f220513e336b73978ee1985f308797aeed117471e5ad13e079a6076a84

# ─── AI (OpenAI-compatible) ───────────────────────
# Required for ai_prompt nodes. Leave empty to skip AI features.
OPENAI_API_KEY=sk-your-key
OPENAI_BASE_URL=https://api.openai.com

# ─── Logging ──────────────────────────────────────
LOG_LEVEL=debug

# ─── Telemetry (optional) ─────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
